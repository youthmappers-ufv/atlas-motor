// Prancha 11 — Uso do solo e agricultura: lavouras, café, pastagem, silvicultura e pivôs centrais.
(
  nwr({{bbox}})[landuse~"^(farmland|orchard|vineyard|meadow|forest|plant_nursery|greenhouse_horticulture|farmyard|residential|industrial|commercial|quarry)$"];
