// Prancha 18 — Agroindústria e armazenagem: silos, armazéns, cooperativas e beneficiamento.
(
  nwr({{bbox}})[man_made~"^(silo|storage_tank|works)$"];
  nwr({{bbox}})[building~"^(warehouse|barn|silo|greenhouse|industrial|cowshed|sty)$"];
  nwr({{bbox}})[landuse~"^(industrial|farmyard)$"];
  nwr({{bbox}})[industrial];
  nwr({{bbox}})[shop~"^(agrarian|farm)$"];
  nwr({{bbox}})[office=cooperative];
);
